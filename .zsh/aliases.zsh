###################
### Start Alias ###
###################
alias ..="cd .."
alias ls="ls --color=auto"
alias ll="ls -l"
alias la="ls -la"
alias update="yay -Syu"
alias ss="sudo systemctl"
alias collect="sudo pacman -Sc"
alias v="nvim"
alias sv="sudo -E nvim" # Open neovim as sudo with the configs loaded

alias -s conf=nvim # open *.conf with neovim
alias -s yml=nvim # open *.yml with neovim
alias -s yaml=nvim # open *.yaml with neovim
###################
###   END Alias ###
###################

